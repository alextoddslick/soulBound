{
	"schemaVersion": 1,
	"id": "soulbound",
	"version": "${version}",
	"name": "SoulBound",
	"description": "The SoulBound mod for Minecraft Fabric 1.21",
	"authors": [
		"Alex Todd"
	],
	"contact": {
		"homepage": "https://github.com/alextodd/soulBound",
		"sources": "https://github.com/alextodd/soulBound"
	},
	"license": "LGPL-3.0-or-later",
	"icon": "assets/soulbound/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.soulbound.SoulBound"
		],
		"client": [
			"com.soulbound.SoulBoundClient"
		]
	},
	"mixins": [
		"soulbound.mixins.json",
		{
			"config": "soulbound.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.18.2",
		"minecraft": "~1.21",
		"java": ">=21",
		"fabric-api": "*"
